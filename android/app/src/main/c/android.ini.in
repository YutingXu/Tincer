[binaries]
c = ['@CMAKE_C_COMPILER@', '--target=@CMAKE_C_COMPILER_TARGET@', '--sysroot=@CMAKE_SYSROOT@']
ar = '@CMAKE_AR@'
strip = '@CMAKE_STRIP@'

[host_machine]
system = 'android'
cpu_family = '@TINC_CPU_FAMILY@'
cpu = '@TINC_CPU@'
endian = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args = ['-fPIE']
c_link_args = ['-pie', '-Wl,-z,max-page-size=16384']
